# ==== General ====
NODE_ENV=production

# ==== Backend ====
PORT=4000
# 32-byte hex key used to encrypt stored MikroTik router passwords (AES-256-GCM)
# generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace_with_64_hex_characters_generated_via_openssl_rand_hex_32
# secret used to sign session/auth tokens
JWT_SECRET=replace_with_a_long_random_secret
# path to the local SQLite database file (inside backend container/volume)
DATABASE_PATH=./data/hersnnet.db
# directory where generated TXT/PDF/XLSX files are stored
LIBRARY_PATH=./data/library
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ==== Frontend (build-time) ====
VITE_API_URL=http://localhost:4000/api
